# Use a Python image that has build tools pre-installed
FROM python:3.11-bullseye AS builder

# Update package lists and install system dependencies with --fix-missing
RUN apt-get update && apt-get install -y --fix-missing \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install maturin for building Python extensions with Rust
RUN pip install --no-cache-dir maturin>=1.9.3

# Set working directory
WORKDIR /app/sdk

# Copy the entire SDK structure (context is now project root)
COPY sdk/sdk-core/ ../sdk-core/
COPY sdk/sdk-python/Cargo.toml sdk/sdk-python/Cargo.lock ./
COPY sdk/sdk-python/pyproject.toml ./
COPY sdk/sdk-python/rust-src/ ./rust-src/
COPY sdk/sdk-python/src/ ./src/

# Copy proto files (sdk-core references ../../protos/proto)
COPY protos/ ../../protos/

# Build the Rust extension
RUN maturin build --release

# Install the built wheel
RUN pip install --no-cache-dir target/wheels/*.whl

FROM python:3.11-slim

# Copy the built SDK from builder stage
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Set working directory
WORKDIR /app/sdk

# Copy examples and source for hot reload
COPY sdk/sdk-python/examples/ ./examples/
COPY sdk/sdk-python/src/ ./src/

# Default command - can be overridden in docker-compose
CMD ["python", "examples/function_worker.py"]