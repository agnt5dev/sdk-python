# AGNT5 Test Service - Environment Variables
# ==========================================
#
# This file documents the environment variables used by the test service worker.
# Copy this file to .env and add your API keys to run LM integration tests.
#
# Usage:
#   1. Copy this file: cp .env.example .env
#   2. Add your API keys to the .env file
#   3. Run tests: pytest tests/integration/test_client_lm.py -v
#
# IMPORTANT:
#   - LM integration tests REQUIRE OPENAI_API_KEY
#   - Tests will FAIL without API key (no fallbacks)
#   - This is intentional to ensure real LM integration is tested
#
# Security:
#   - NEVER commit the .env file to git
#   - The .gitignore is configured to ignore .env files

# ============================================================================
# LLM Provider API Keys
# ============================================================================

# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
# Used by: openai_lm_functions (generate_greeting, analyze_sentiment, generate_story, chat_with_context, generate_joke)
OPENAI_API_KEY=sk-...

# Anthropic API Key
# Get yours at: https://console.anthropic.com/
# Used by: anthropic_lm_functions (generate_text_anthropic, summarize_with_anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Groq API Key
# Get yours at: https://console.groq.com/
# Used by: Optional - for testing Groq models (fast inference)
GROQ_API_KEY=gsk_...

# OpenRouter API Key
# Get yours at: https://openrouter.ai/keys
# Used by: openrouter_lm_functions (generate_text_openrouter, compare_models_openrouter)
OPENROUTER_API_KEY=sk-or-...

# ============================================================================
# Additional Configuration (Optional)
# ============================================================================

# Override coordinator endpoint (usually set by pytest fixture)
# AGNT5_COORDINATOR_ENDPOINT=http://localhost:34186

# Override service name (usually set by worker)
# AGNT5_SERVICE_NAME=test-service

# Enable verbose logging
# LOG_LEVEL=DEBUG
